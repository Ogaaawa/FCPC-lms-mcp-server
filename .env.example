# OpenAI API key (only needed for client.py)
OPENAI_API_KEY="your_api_key"

# Your Moodle site, e.g. https://yourmoodle.com
MOODLE_URL="your_moodle_url"

# Moodle web service token (setup fills this in for you)
MOODLE_TOKEN="your_token"

# Model to use, e.g. gpt-4o (or llama3 with ollama)
LLM_MODEL="your_llm_model"

# Public address of the remote MCP server, e.g. https://xxxx.trycloudflare.com
CONNECTOR_BASE_URL="your_server_url"
